---
import { quotes } from '@/data/quotes'

// Fallback initial quote for SSR / prerender
const initialQuote = quotes[0]
---

<footer>
  <div class="footer-content">
    <p id="footer-quote" class="valar" title="Click to randomize quote">{initialQuote}</p>
  </div>
</footer>

<script>
  import { quotes } from '@/data/quotes'

  function randomizeQuote() {
    const el = document.getElementById('footer-quote')
    if (!el || quotes.length === 0) return
    const randomIndex = Math.floor(Math.random() * quotes.length)
    el.textContent = quotes[randomIndex]
  }

  document.addEventListener('astro:page-load', () => {
    randomizeQuote()

    const el = document.getElementById('footer-quote')
    if (el && !el.dataset.bound) {
      el.dataset.bound = 'true'
      el.addEventListener('click', randomizeQuote)
    }
  })
</script>

<style>
  footer {
    font-size: var(--font-size-m);
    line-height: 1.6;
    margin-top: 4rem;
    margin-bottom: 2.5rem;
    text-align: center;
    opacity: 1 !important;
  }

  .footer-content {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .valar {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    letter-spacing: 0.02em;
    color: #000000 !important;
    opacity: 1 !important;
    cursor: pointer;
    user-select: none;
  }

  @media (prefers-color-scheme: dark) {
    .valar {
      color: #ffffff !important;
    }
  }

  :global(html.light) .valar {
    color: #000000 !important;
    opacity: 1 !important;
  }

  :global(html.dark) .valar {
    color: #ffffff !important;
    opacity: 1 !important;
  }
</style>
